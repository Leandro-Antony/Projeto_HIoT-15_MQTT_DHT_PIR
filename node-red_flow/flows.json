    {
        "id": "28e6e1edfc2b565a",
        "type": "function",
        "z": "d7b613519a3c46e6",
        "name": "Regra Temp",
        "func": "let t = parseFloat(msg.payload);\nlet alerta = null;\nlet led = '0';\n\nif (t < 20) {\n    alerta = { payload: 'ALERTA: Temperatura Baixa (' + t.toFixed(1) + ' °C)' };\n    led = '1';\n} else if (t > 25) {\n    alerta = { payload: 'ALERTA: Temperatura Alta (' + t.toFixed(1) + ' °C)' };\n    led = '1';\n}\n\nreturn [alerta, { payload: led }];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 340,
        "wires": [
