    {
        "id": "14e4804db5d2027d",
        "type": "function",
        "z": "d7b613519a3c46e6",
        "name": "Regra PIR",
        "func": "let p = parseInt(msg.payload);\nlet alerta = null;\nlet led = '0';\n\nif (p === 1) {\n    alerta = { payload: 'ALERTA: Movimento detectado no ambiente!' };\n    led = '1';\n}\n\nreturn [alerta, { payload: led }];",
