                "b911a7a683e73b3a"
            ],
            [
                "09605658fb94189f"
            ]
        ]
    },
    {
        "id": "41aa12d6b25b4cf5",
        "type": "function",
        "z": "d7b613519a3c46e6",
        "name": "Regra Umidade",
        "func": "let h = parseFloat(msg.payload);\nlet alerta = null;\nlet led = '0';\n\nif (h > 50) {\n    alerta = { payload: 'ALERTA: Umidade Elevada (' + h.toFixed(1) + '%)' };\n    led = '1';\n}\n\nreturn [alerta, { payload: led }];",
        "outputs": 2,
